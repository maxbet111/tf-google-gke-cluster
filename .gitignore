# Локальна папка Terraform (кеш провайдерів та модулів)
.terraform/

# Файли стану (ми вже перенесли їх у GCS, але локальні копії теж не потрібні)
*.tfstate
*.tfstate.*

# Файли зі значеннями змінних (можуть містити паролі або токени)
*.tfvars
*.tfvars.json

# Локальні файли конфігурації провайдерів
.terraform.rc
terraform.rc

# Ключі сервісних акаунтів (JSON файли з секретами)
*.json
# Але будьте обережні, якщо у вас є інші потрібні JSON, краще прописати конкретне ім'я:
# credentials.json